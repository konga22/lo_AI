# vLLM
VLLM_IMAGE=vllm/vllm-openai:v0.29.0

# Network / GPU
BIND_ADDRESS=127.0.0.1
NVIDIA_GPU_ID=0

# Ports
CHAT_PORT=8000
EMBEDDING_PORT=8001

# API keys
VLLM_API_KEY=
HF_TOKEN=

# Chat model
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct-GPTQ-Int4
CHAT_MODEL_ID=notemind-chat
CHAT_MAX_MODEL_LEN=8192
CHAT_GPU_MEMORY_UTILIZATION=0.85
CHAT_MAX_NUM_SEQS=4

# Embedding model
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_ID=notemind-embedding
EMBEDDING_MAX_MODEL_LEN=2048
EMBEDDING_GPU_MEMORY_UTILIZATION=0.20
EMBEDDING_MAX_NUM_SEQS=4